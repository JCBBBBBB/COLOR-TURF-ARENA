# Public URL of the persistent game API (Render, Railway, Fly.io, etc.).
# This value is baked into the Vite build; do not put secrets here.
VITE_GAME_API_URL=https://your-game-api.example.com

# Configure these on the game API host, not in Vercel.
ALLOWED_ORIGINS=https://your-vercel-project.vercel.app
REDIS_URL=redis://your-managed-redis.example.com:6379
ADMIN_TOKEN=replace-with-a-strong-admin-token
OPS_EVENT_TOKEN=replace-with-a-strong-ops-token
